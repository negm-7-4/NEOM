# ---------------------------------------------------------------------------
# NEOM registration site — server environment
# Copy to .env.local for development. NEVER commit a filled-in copy.
# Every value here is server-only: nothing is prefixed NEXT_PUBLIC_, so none of
# it is bundled into the browser.
# ---------------------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys
# A "Sending access" key is enough — this app only sends.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where registration notifications are delivered. This is the centre's own
# inbox and is configured HERE ONLY — it is never taken from anything in the
# submitted form or from any address embedded in the source form content.
OWNER_EMAIL=registrations@your-domain.com

# Sender address. The domain MUST be verified in Resend (see README →
# "Verify a sending domain"), otherwise Resend rejects the send.
# Display-name form is supported.
EMAIL_FROM=NEOM Registration <no-reply@your-domain.com>

# ---------------------------------------------------------------------------
# Optional — shared rate-limit / idempotency store
# ---------------------------------------------------------------------------
# Without these the app uses a per-instance in-memory store. That is correct
# for a single long-lived Node server (`next start`, a container, a VPS) but
# NOT for serverless/multi-instance deployments, where each instance would keep
# its own counters. Set both to make the limiter and the duplicate-submission
# guard shared and correct across instances.
# Create a free database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: salt for the rate limiter's client-address hashes. Set any random
# string in production so hashes are not comparable across deployments.
RATE_LIMIT_SALT=
